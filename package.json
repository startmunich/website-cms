{
  "name": "website",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "MIT",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "sanity start",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "typegen": "sanity schemas extract --force --enforce-required-fields && sanity typegen generate"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/vision": "^6.16.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^6.16.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7.0.0",
    "@types/react": "^19.3.0",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "js-yaml": "3.15.2",
    "smol-toml": "1.9.0",
    "undici": "7.29.1",
    "typeid-js": {
      "uuid": "11.1.1"
    }
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md}": "prettier --write"
  }
}
